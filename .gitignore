# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# macOS specific files
.DS_Store

# IDE/editor specific files
.idea/
.vscode/
*.swp
*.swo

# Archives and compressed files
*.zip
*.tar.gz
*.tar
*.gz
*.bz2

# Go build binaries
xray
xray_softfloat
mockgen
vprotogen
!infra/vprotogen/
errorgen
!common/errors/errorgen/
*.dat

# Build assets
/build_assets/

# Output from dlv test
**/debug.*

# Certificates and keys
*.crt
*.key

# Dependency directories (uncomment if needed)
# vendor/

# Logs
*.log

# Coverage reports
coverage.*

# Node modules (in case of frontend assets)
node_modules/

# System files
Thumbs.db
ehthumbs.db

# Other common ignores
*.bak
*.tmp

# === Xray-core Zig 移植（本项目新增，M31 首次提交时补） ===
# 本地通道脚本（含设备凭证）
.temp/
# 代理工作区数据（会话/记忆，非交付物）
.workbuddy-ai/
# zig 构建缓存（本地 664M）
zig-src/.zig-cache/
# 构建产物（部署件在设备/打包机，md5 记录于 PROGRESS.md；重建约 1 分钟，见交付说明）
zig-src/dist/
# 大体积渲染图/文档文本导出（源文档为同名 .html/.md）
zig-src/doc-full.png
zig-src/.temp_doc.txt
